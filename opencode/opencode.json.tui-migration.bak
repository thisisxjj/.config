{
  "$schema": "https://opencode.ai/config.json",
  "theme": "catppuccin",
  "plugin": ["opencode-gemini-auth@latest"],
  "model": "anthropic/claude-opus-4-5",
  "autoupdate": true,
  "mcp": {
    "shadcn": {
      "enabled": true,
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"]
    }
  }
}
